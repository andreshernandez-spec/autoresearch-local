#!/usr/bin/env python3
"""Launcher. Needs no install: it puts ../src on the path and runs the CLI."""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("arl needs Python 3.11 or newer")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from arl.cli import main  # noqa: E402

sys.exit(main())
